#!/bin/sh
# Run qqperf from this checkout's source on the system python3, with nothing installed: the trusted
# jobs (perf.yml's store and perf-publish.yml) use it so that no build backend, package index or
# Python download runs in them. qqperf needs only the standard library (Python 3.11 or later);
# `bundle` also needs qqresults on PYTHONPATH. -P keeps the working directory off sys.path.
src=$(cd "$(dirname "$0")/../src" && pwd)
PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -P -m qqperf "$@"
